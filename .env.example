# ============================================================
# 研报 AI Agent 环境变量样例。复制为 .env 后填入真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================

# 运行模式：auto（有 LLM_API_KEY 即在线，否则离线演示）/ online / offline
LLM_MODE=auto

# ---- 大模型：任意 OpenAI 兼容端点，三选一即可（以下为常见厂商示例）----
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek（默认示例，性价比高，适合长文研报）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 火山引擎 · 豆包方舟
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxxxxxxxxxx

# 阿里通义千问 DashScope 兼容模式
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 月之暗面 Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k

# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

LLM_API_KEY=sk-请替换为你的密钥
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ---- Embedding（RAG 向量化，可选）----
# 留空则复用上面的 LLM_BASE_URL / LLM_API_KEY；未配置时自动回退本地哈希向量，RAG 仍可用
EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-xxx

# ---- 检索渠道：auto / duckduckgo（免费免密钥）/ tavily / mock ----
SEARCH_PROVIDER=auto
# Tavily 质量更高，可选填：https://tavily.com
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_MAX_FETCH=3
FETCH_CHARS=2000

# ---- 报告与流程 ----
REPORT_LANGUAGE=zh
REVIEW_MAX_ROUNDS=1
OUTPUT_DIR=output
EXPORT_FORMATS=md,html
LOG_LEVEL=INFO
